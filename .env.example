MAX_INVESTIGATION_STEPS=5
MAX_TOOL_CALLS=10
MAX_RUNTIME_SECONDS=60

THREATLENS_BASE_URL=http://threatlens:8000
THREATLENS_API_KEY=
THREATLENS_CONNECT_TIMEOUT_SECONDS=5
THREATLENS_READ_TIMEOUT_SECONDS=15

RECONIX_CLOUD_BASE_URL=http://api:8080
RECONIX_CLOUD_API_KEY=
RECONIX_CLOUD_CONNECT_TIMEOUT_SECONDS=5
RECONIX_CLOUD_READ_TIMEOUT_SECONDS=30

LLM_PROVIDER=gemini
LLM_MAX_INPUT_BYTES=50000
LLM_MAX_OUTPUT_TOKENS=4096

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_CONNECT_TIMEOUT_SECONDS=5
GEMINI_READ_TIMEOUT_SECONDS=30

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_CONNECT_TIMEOUT_SECONDS=5
OPENAI_READ_TIMEOUT_SECONDS=30

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_CONNECT_TIMEOUT_SECONDS=5
OPENROUTER_READ_TIMEOUT_SECONDS=30
